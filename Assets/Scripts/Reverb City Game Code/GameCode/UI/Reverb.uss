.hide {
    display: none;
    -unity-background-image-tint-color: rgb(248, 248, 248);
}
.Background{
    background-color: rgba(53, 56, 78, 0.95);
    width: 100%;
    height: 100%;
    align-items: center;

}
.ScoreLabel{
    width: 25%;
    height: 5%;
    align-self: flex-end;
    margin-top: 20px;

    font-size: 40;
    color: white;
}
.PopUpPanel{
    width: 60%;
    border-width: 10px;
    border-color: grey;
    justify-content: center;
    align-self: center;
}
.Header{
    color: floralwhite;
    -unity-font-style: bold;
    font-size: 60;
}

.Body{
    color: floralwhite;
    font-size: 25;
}
.StartButton{
    height: 75px;
    width: 300px;
    font-size: 40;
}
WaveUIPanel{
    width: 20%;
    height: 100%;
    align-self: flex-end;
    margin: 20px;
}
.WaveInfo{
    color: white;
    font-size: 20;
}
.PauseMenu{
    background-color: rgba(128, 128, 128, 0.68);
    align-items:  center;
}
.PauseButton{
    font-size: 30px;
    margin: 10px;
}
.PauseLabel{
    font-size: 100px;
}
.PausePanel{
    align-items: center;

    width: 40%;
    height: 100%;
    background-color:  blue;
}
